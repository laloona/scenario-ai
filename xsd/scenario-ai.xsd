<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <xsd:element name="scenario-ai">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="adapter">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="var" minOccurs="0" maxOccurs="unbounded">
                                <xsd:complexType>
                                    <xsd:simpleContent>
                                        <xsd:extension base="xsd:string">
                                            <xsd:attribute name="name" type="nonWhitespaceString" use="required"/>
                                        </xsd:extension>
                                    </xsd:simpleContent>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>

                        <xsd:attribute name="type" type="nonWhitespaceString" use="required"/>
                        <xsd:attribute name="class" type="className"/>
                        <xsd:attribute name="path" type="pathType"/>
                    </xsd:complexType>

                    <xsd:unique name="uniqueVariableNames">
                        <xsd:selector xpath="var"/>
                        <xsd:field xpath="@name"/>
                    </xsd:unique>
                </xsd:element>
            </xsd:sequence>

            <xsd:attribute name="maxQuestions" type="xsd:integer"/>
            <xsd:attribute name="projectDoc" type="pathType"/>
        </xsd:complexType>
    </xsd:element>

    <xsd:simpleType name="nonWhitespaceString">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="\S+"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="pathType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[^ \t\r\n]+"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="className">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="\\?[a-zA-Z_][a-zA-Z0-9_]*(\\[a-zA-Z_][a-zA-Z0-9_]*)*"/>
        </xsd:restriction>
    </xsd:simpleType>

</xsd:schema>