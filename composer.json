{
  "name": "stateforge/scenario-ai",
  "description": "AI-assisted generation of Scenarios, Parameter Types, and coding agent skills.",
  "type": "library",
  "keywords": [
    "testing",
    "phpunit",
    "fixtures",
    "scenario",
    "state",
    "test-data",
    "ai",
    "code-generation"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Christina Koenig",
      "email": "christina.koenig@looriva.de",
      "role": "lead"
    }
  ],
  "homepage": "https://github.com/laloona/scenario-ai",
  "support": {
    "issues": "https://github.com/laloona/scenario-ai/issues",
    "source": "https://github.com/laloona/scenario-ai"
  },
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.8",
    "nikic/php-parser": "^5.9",
    "stateforge/scenario-core": "^1.2.3"
  },
  "autoload": {
    "psr-4": {
      "Stateforge\\Scenario\\Ai\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stateforge\\Scenario\\Ai\\Tests\\Unit\\": "tests/unit/"
    },
    "classmap": [
      "tests/files"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.60",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5.50 || ^12.5.22 || ^13.1.6",
    "tomasvotruba/type-coverage": "^2.2"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.1-dev"
    }
  }
}
