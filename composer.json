{
  "name": "stateforge/scenario-ai",
  "description": "Implementation to generate scenario classes with AI.",
  "type": "symfony-bundle",
  "keywords": [
    "testing",
    "phpunit",
    "fixtures",
    "scenario",
    "state",
    "test-data",
    "symfony",
    "ai"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Christina Koenig",
      "email": "christina.koenig@looriva.de",
      "role": "lead"
    }
  ],
  "homepage": "https://github.com/laloona/scenario-ai",
  "support": {
    "issues": "https://github.com/laloona/scenario-ai/issues",
    "source": "https://github.com/laloona/scenario-ai"
  },
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "*",
    "nikic/php-parser": "^5.9",
    "stateforge/scenario-core": "~1.2-dev"
  },
  "autoload": {
    "psr-4": {
      "Stateforge\\Scenario\\Ai\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stateforge\\Scenario\\Ai\\Tests\\Unit\\": "tests/unit/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.60",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5.50 || ^12.5.22 || ^13.1.6",
    "tomasvotruba/type-coverage": "^2.2"
  },
  "extra": {
    "symfony": {
      "bundles": {
        "Stateforge\\Scenario\\Symfony\\ScenarioBundle": [
          "all"
        ]
      }
    },
    "branch-alias": {
      "dev-main": "1.2-dev"
    }
  }
}
